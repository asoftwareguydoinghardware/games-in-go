// and really want something like a listener goroutine that adds connections
// to a channel.
//
// a "main" routine will essentially take pairs of connections from the
// channel and start games with them
//
// if one player leaves a game/tournament, then the other can have its
// connection added back to the channel to "quickly" get paired up with
// another player.
//
// This should be doable with a new type that implements the net.Listener
// interface.
func runGames(conf config) {
	var conns connections

	conns.g = conf.g
	for c, err := listener.Accept() {
		if err != nil {
			log.Fatal(err)
		}
		conns.handleConn(c)
	}
}

func (conns *connections)handleConn(c net.Conn) {
	if conns.initialPlayer == nil {
		cons.initialPlayer = createInitialPlayer(c)
	} else {
		go conns.startGame(conns.initialPlayer, c)
		conns.initialPlayer = nil
	}
}

